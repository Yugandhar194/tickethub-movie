# ─── Backend ────────────────────────────────────────────────────────────────
# "spring" targets the TicketHub API (local default http://localhost:8080; production fallback is configured in src/config/env.js).
# "dotnet" targets the ASP.NET API (default http://localhost:5266); note that the
# .NET project in the repo has no booking, booked-seat or ticket endpoints yet.
VITE_BACKEND=spring
VITE_API_BASE_URL=https://tickethub-api-iota.vercel.app/
# Optional Cinehold API origin for email/WhatsApp OTP, schedules, seat holds,
# checkout and payment verification. Configure Cinehold CORS to allow the Vite
# origin in its PLATFORM setting.
VITE_AUTH_API_BASE_URL=

# ─── Google sign-in ─────────────────────────────────────────────────────────
# Must match GOOGLE_CLIENT_ID configured in tickethub-api/.env.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# ─── TMDB (live releases, trending, box office) ─────────────────────────────
# Free key: https://www.themoviedb.org/settings/api  (Settings → API → Create).
# Either the v3 "API Key" or the v4 "API Read Access Token" works here.
# Without a key the app falls back to the movies stored in your backend, and if
# that is offline too, to a small clearly-labelled demo set.
VITE_TMDB_API_KEY=
VITE_TMDB_REGION=IN
VITE_TMDB_LANGUAGE=en-US

# ─── OMDb (optional: IMDb / Rotten Tomatoes ratings) ────────────────────────
# Free key: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# ─── Payments ───────────────────────────────────────────────────────────────
# Razorpay *key id* (public). Must belong to the same account as the key the
# backend uses to create orders. Set this to the same account's public key id configured on the backend.
VITE_RAZORPAY_KEY_ID=your-matching-razorpay-key-id

# ─── Pricing and seat hold (all optional) ───────────────────────────────────
# These values must match CONVENIENCE_FEE_PCT and GST_PCT in tickethub-api/.env.
# Percent added on top of ticket + F&B. Leave at 0 to charge only the catalogue prices.
VITE_CONVENIENCE_FEE_PCT=0
VITE_GST_PCT=0
# Minutes a seat selection is held on screen before it resets (client-side only).
VITE_SEAT_HOLD_MINUTES=8

# Lets customers edit their profile on /account. Leave off until the backend update endpoint keeps the
# stored password (it currently saves the posted object as-is, which can wipe it).
VITE_ENABLE_PROFILE_EDIT=false

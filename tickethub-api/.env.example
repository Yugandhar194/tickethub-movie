# Copy to .env. Every value is optional: with no .env at all the API runs on port 8080 with a local SQLite file,
# demo accounts, sample movies, simulated payments and one-time codes printed in this terminal.

PORT=8080
DB_FILE=./data/tickethub.db

# Browser origins allowed to call the API (comma separated). Must include where the frontend runs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tickethub-movie.vercel.app
# Used for the QR code on ticket PDFs. Set this to the deployed UI origin in Vercel.
FRONTEND_URL=https://tickethub-movie.vercel.app

# Signs login tokens. Set a long random string before going live:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=f244a38442502331add3eb63cbf468b11b7112077dbd38669197b92595be699e27b57de77d016c32fdd26b7a88dd4138

# ── Live movies (free key: themoviedb.org/settings/api) ─────────────────────
# With a key, the first start imports now playing, trending and upcoming films, and replaces the sample films.
# Re-import any time from Admin > Movie catalogue > Sync now.
TMDB_API_KEY=
TMDB_REGION=IN

# ── Sign-in codes ────────────────────────────────────────────────────────────
# No SMTP_HOST: codes are printed in this terminal and shown on the sign-in screen (development only).
# With SMTP_HOST set, codes are emailed. Gmail example: smtp.gmail.com, port 587, an App Password as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yugsjdeshmukh194@gmail.com
SMTP_PASS=Yugandhar@194
SMTP_FROM=yugsjdeshmukh194@gmail.com

# ── Google sign-in ──────────────────────────────────────────────────────────
# OAuth 2.0 Web client ID. Use the same value as VITE_GOOGLE_CLIENT_ID in the UI.
GOOGLE_CLIENT_ID=yugsjdeshmukh194@gmail.com

# ── Booking notifications ───────────────────────────────────────────────────
# Gmail/Nodemailer reuses SMTP_* above; customers receive confirmation email after verified payment.
# Meta WhatsApp Cloud API: use an approved utility template with 5 body parameters in this order:
# booking code, movie title, show date/time, seats, total amount.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=tickethub_booking_confirmed
WHATSAPP_GRAPH_VERSION=v24.0

# ── Payments ─────────────────────────────────────────────────────────────────
# No keys: payments are simulated and the UI skips the Razorpay window.
# With both keys (test keys are fine) real Razorpay orders are created and signatures are verified.
# RAZORPAY_KEY_ID must match VITE_RAZORPAY_KEY_ID in the frontend .env.
RAZORPAY_KEY_ID=rzp_test_U5DNhKfsVce3J9
RAZORPAY_KEY_SECRET=I16hzBs134y5jp7L6gtEZqyB

# Checkout rates must match VITE_CONVENIENCE_FEE_PCT and VITE_GST_PCT in the frontend.
CONVENIENCE_FEE_PCT=1.5
GST_PCT=2.5

# ── Rules ────────────────────────────────────────────────────────────────────
# Minutes a seat stays locked while the customer pays.
SEAT_HOLD_MINUTES=5
# Confirmed bookings can be cancelled until this many hours before the show.
CANCEL_CUTOFF_HOURS=2
# Create demo accounts and sample films on an empty database (set false in production).
SEED_DEMO=true
# Keep the next 7 days stocked with showtimes for films that are out.
AUTO_SCHEDULE=true
